    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "raw = Path(\"../data/raw\")\n",
    "for f in sorted(raw.glob(\"*.csv\")):\n",
    "    df = pd.read_csv(f)\n",
    "    print(f.name, df.shape)\n",
    "    print(list(df.columns))\n",
    "    print(df.head(3), \"\\n\")"
   ]
